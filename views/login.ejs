<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Portfolio Builder</title>
    <meta name="description"
        content="Login to Portfolio Builder to manage your professional presence, update projects, and showcase your skills.">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.6)), url('/images/light_portfolio_builder_bg.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
        }

        .auth-container {
            background: transparent !important;
        }
    </style>
</head>

<body>

    <%- include('partials/header') %>

        <div class="auth-container" style="flex-direction: column; gap: 40px; padding: 60px 20px;">
            <div class="card auth-card">
                <div class="card-header" style="text-align: center;">
                    <h2 class="card-title">Welcome Back</h2>
                    <p class="card-subtitle">Login to manage your portfolio</p>
                </div>

                <% if (typeof error_msg !=='undefined' && error_msg.length> 0) { %>
                    <div class="alert alert-error">
                        <i class="fas fa-exclamation-circle"></i>
                        <%= error_msg %>
                    </div>
                    <% } %>
                        <% if (typeof success_msg !=='undefined' && success_msg.length> 0) { %>
                            <div class="alert alert-success">
                                <i class="fas fa-check-circle"></i>
                                <%= success_msg %>
                            </div>
                            <% } %>
                                <% if (typeof error !=='undefined' && error.length> 0) { %>
                                    <div class="alert alert-error">
                                        <i class="fas fa-exclamation-circle"></i>
                                        <%= error %>
                                    </div>
                                    <% } %>

                                        <form action="/login" method="POST">
                                            <div class="form-group">
                                                <label class="form-label">Email Address</label>
                                                <input type="email" name="email" class="form-input"
                                                    placeholder="you@example.com" required>
                                            </div>

                                            <div class="form-group">
                                                <label class="form-label">Password</label>
                                                <div style="position: relative;">
                                                    <input type="password" name="password" id="login-password"
                                                        class="form-input" placeholder="••••••••" required>
                                                    <button type="button" id="toggle-password"
                                                        style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--slate-400);">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </div>
                                                <div style="text-align: right; margin-top: 8px;">
                                                    <a href="/forgot-password"
                                                        style="font-size: 0.85rem; color: #6366f1; text-decoration: none;">Forgot
                                                        Password?</a>
                                                </div>
                                            </div>

                                            <button type="submit" class="btn btn-primary btn-full">Login</button>
                                        </form>

                                        <p
                                            style="margin-top: 24px; text-align: center; font-size: 0.9rem; color: var(--slate-600);">
                                            No account? <a href="/register">Create one now</a>
                                        </p>
            </div>

            <!-- Features Section -->
            <div style="max-width: 800px; width: 100%; margin-top: 20px;">
                <h3
                    style="text-align: center; margin-bottom: 40px; font-size: 1.8rem; color: var(--slate-900); font-weight: 800; letter-spacing: -0.025em;">
                    Build your professional portfolio in <span
                        style="background: linear-gradient(135deg, #6366f1, #a855f7); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">minutes</span>
                </h3>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
                    <!-- AI Feature -->
                    <div style="background: white; padding: 28px; border-radius: 20px; border: 1px solid var(--slate-200); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: default;"
                        onmouseover="this.style.borderColor='#6366f1'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 20px 25px -5px rgba(0,0,0,0.1)';"
                        onmouseout="this.style.borderColor='var(--slate-200)'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px -1px rgba(0,0,0,0.1)';">
                        <div
                            style="width: 48px; height: 48px; background: #eef2ff; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <i class="fas fa-wand-magic-sparkles" style="color: #6366f1; font-size: 1.25rem;"></i>
                        </div>
                        <h4 style="margin: 0 0 10px 0; font-size: 1.15rem; color: var(--slate-900); font-weight: 700;">
                            AI Resume Parsing</h4>
                        <p style="margin: 0; font-size: 0.9rem; color: var(--slate-600); line-height: 1.6;">Upload your
                            resume and let our Gemini-powered AI automatically build your entire profile for you.</p>
                    </div>

                    <!-- Themes Feature -->
                    <div style="background: white; padding: 28px; border-radius: 20px; border: 1px solid var(--slate-200); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: default;"
                        onmouseover="this.style.borderColor='#db2777'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 20px 25px -5px rgba(0,0,0,0.1)';"
                        onmouseout="this.style.borderColor='var(--slate-200)'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px -1px rgba(0,0,0,0.1)';">
                        <div
                            style="width: 48px; height: 48px; background: #fdf2f8; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <i class="fas fa-palette" style="color: #db2777; font-size: 1.25rem;"></i>
                        </div>
                        <h4 style="margin: 0 0 10px 0; font-size: 1.15rem; color: var(--slate-900); font-weight: 700;">
                            Premium Themes</h4>
                        <p style="margin: 0; font-size: 0.9rem; color: var(--slate-600); line-height: 1.6;">Access
                            exclusive, modern themes designed for high conversion. From minimal to cyberpunk styles.</p>
                    </div>

                    <!-- Stats Feature -->
                    <div style="background: white; padding: 28px; border-radius: 20px; border: 1px solid var(--slate-200); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: default;"
                        onmouseover="this.style.borderColor='#ea580c'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 20px 25px -5px rgba(0,0,0,0.1)';"
                        onmouseout="this.style.borderColor='var(--slate-200)'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px -1px rgba(0,0,0,0.1)';">
                        <div
                            style="width: 48px; height: 48px; background: #fff7ed; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <i class="fas fa-chart-line" style="color: #ea580c; font-size: 1.25rem;"></i>
                        </div>
                        <h4 style="margin: 0 0 10px 0; font-size: 1.15rem; color: var(--slate-900); font-weight: 700;">
                            Coding Analytics</h4>
                        <p style="margin: 0; font-size: 0.9rem; color: var(--slate-600); line-height: 1.6;">Integrate
                            your GitHub and LeetCode profiles to show off your real-time coding achievements.</p>
                    </div>

                    <!-- Deployment Feature -->
                    <div style="background: white; padding: 28px; border-radius: 20px; border: 1px solid var(--slate-200); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: default;"
                        onmouseover="this.style.borderColor='#16a34a'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 20px 25px -5px rgba(0,0,0,0.1)';"
                        onmouseout="this.style.borderColor='var(--slate-200)'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px -1px rgba(0,0,0,0.1)';">
                        <div
                            style="width: 48px; height: 48px; background: #f0fdf4; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <i class="fas fa-rocket" style="color: #16a34a; font-size: 1.25rem;"></i>
                        </div>
                        <h4 style="margin: 0 0 10px 0; font-size: 1.15rem; color: var(--slate-900); font-weight: 700;">
                            Instant Deployment</h4>
                        <p style="margin: 0; font-size: 0.9rem; color: var(--slate-600); line-height: 1.6;">One click to
                            publish. Your professional site is hosted instantly on your unique subpath.</p>
                    </div>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('toggle-password').addEventListener('click', function () {
                const passwordInput = document.getElementById('login-password');
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                this.querySelector('i').classList.toggle('fa-eye');
                this.querySelector('i').classList.toggle('fa-eye-slash');
            });
        </script>
</body>

</html>