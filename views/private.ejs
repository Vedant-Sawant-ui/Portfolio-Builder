<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Private Portfolio - Portfolio Builder</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: #f8fafc;
            color: #1e293b;
            text-align: center;
            padding: 20px;
        }

        .container-private {
            background: white;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            max-width: 500px;
            width: 100%;
        }

        .icon {
            font-size: 50px;
            color: #64748b;
            margin-bottom: 20px;
        }

        h1 {
            margin-bottom: 10px;
            font-size: 1.5rem;
        }

        p {
            color: #64748b;
            margin-bottom: 30px;
        }

        .btn {
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            display: inline-block;
            transition: all 0.2s;
        }

        .btn-primary {
            background: #6366f1;
            color: white;
        }

        .btn-primary:hover {
            background: #4f46e5;
        }
    </style>
</head>

<body>
    <div class="container-private">
        <div class="icon"><i class="fas fa-lock"></i></div>
        <h1>This Portfolio is Private</h1>
        <p>The owner has not published this portfolio yet. If this is you, please log in to your dashboard to publish
            it.</p>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <a href="/" class="btn btn-primary">Go to Homepage</a>
            <a href="/login" style="color: #6366f1; font-size: 0.9rem; text-decoration: none;">Login to Dashboard</a>
        </div>
    </div>
</body>

</html>