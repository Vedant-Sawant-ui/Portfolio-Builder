<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Achievements - Portfolio Builder</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .achievement-entry {
            background: var(--slate-50);
            border: 1px solid var(--slate-200);
            padding: 20px;
            border-radius: var(--radius-md);
            margin-bottom: 20px;
            position: relative;
        }

        .ai-btn {
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            color: white;
            border: none;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            cursor: pointer;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: opacity 0.2s;
        }

        .ai-btn:hover {
            opacity: 0.9;
        }

        .ai-status {
            font-size: 0.8rem;
            color: var(--primary);
            margin-left: 10px;
            display: none;
            align-items: center;
            gap: 5px;
        }
    </style>
</head>

<body>

    <%- include('partials/header') %>

        <div class="container" style="max-width: 800px;">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">🏆 Add Achievements</h2>
                    <p class="card-subtitle">Highlight your hackathon wins, awards, and certifications.</p>
                </div>

                <form action="/dashboard/achievements" method="POST" enctype="multipart/form-data">

                    <!-- Single Form Entry -->
                    <div class="achievement-entry">
                        <div class="form-group">
                            <label class="form-label">Title *</label>
                            <input type="text" name="title" placeholder="e.g. 1st Place Hackathon" required
                                class="form-input">
                        </div>
                        <div class="form-group">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <label class="form-label" style="margin-bottom: 0;">Description</label>
                                <div style="display: flex; align-items: center;">
                                    <span id="ach-ai-status" class="ai-status"><i class="fas fa-spinner fa-spin"></i>
                                        Improving...</span>
                                    <button type="button" class="ai-btn"
                                        onclick="upgradeText('ach-desc', 'ach-ai-status')">
                                        <i class="fas fa-sparkles"></i> Upgrade with AI
                                    </button>
                                </div>
                            </div>
                            <textarea id="ach-desc" name="description"
                                placeholder="Brief details about the achievement..." class="form-textarea"
                                rows="3"></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Date</label>
                            <input type="date" name="date" class="form-input">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Achievement Images</label>
                            <div
                                style="background: white; padding: 10px; border-radius: 6px; border: 1px solid var(--slate-300);">
                                <input type="file" name="achievement_files" accept="image/*" multiple class="form-input"
                                    style="padding: 6px; background: white;" id="ach-files">
                                <div id="ach-previews"
                                    style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px;"></div>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; border-top: 1px solid var(--slate-200); padding-top: 20px;">
                        <button type="submit" class="btn btn-primary">Save Achievement</button>
                        <a href="/dashboard" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <script>
            document.getElementById('ach-files').addEventListener('change', function (e) {
                const container = document.getElementById('ach-previews');
                container.innerHTML = '';
                if (this.files) {
                    Array.from(this.files).forEach(file => {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.style.width = '80px';
                            img.style.height = '80px';
                            img.style.objectFit = 'cover';
                            img.style.borderRadius = '5px';
                            img.style.border = '1px solid #ddd';
                            container.appendChild(img);
                        }
                        reader.readAsDataURL(file);
                    });
                }
            });

            // AI Upgrade Logic
            async function upgradeText(inputId, statusId) {
                const inputEl = document.getElementById(inputId);
                const statusEl = document.getElementById(statusId);
                const originalText = inputEl.value;

                if (!originalText || originalText.length < 5) {
                    alert("Please enter some text first.");
                    return;
                }

                statusEl.style.display = 'inline-flex';

                try {
                    const response = await fetch('/dashboard/api/upgrade-text', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ text: originalText })
                    });
                    const data = await response.json();

                    if (data.upgradedText) {
                        const improvedText = data.upgradedText;
                        let parent = inputEl.parentElement;
                        let existingControl = parent.querySelector('.ai-controls');
                        if (existingControl) existingControl.remove();

                        inputEl.value = improvedText;
                        inputEl.style.background = "#eff6ff";

                        const controls = document.createElement('div');
                        controls.className = 'ai-controls';
                        controls.style.marginTop = '10px';
                        controls.style.display = 'flex';
                        controls.style.gap = '10px';
                        controls.innerHTML = `
                            <button type="button" class="btn btn-primary btn-sm" id="btn-accept" style="background: var(--success); border:none; padding:4px 12px; font-size:0.8rem;">Accept</button>
                            <button type="button" class="btn btn-secondary btn-sm" id="btn-decline" style="padding:4px 12px; font-size:0.8rem;">Decline</button>
                        `;

                        inputEl.insertAdjacentElement('afterend', controls);

                        controls.querySelector('#btn-accept').addEventListener('click', () => {
                            inputEl.style.background = "white";
                            controls.remove();
                        });

                        controls.querySelector('#btn-decline').addEventListener('click', () => {
                            inputEl.value = originalText;
                            inputEl.style.background = "white";
                            controls.remove();
                        });
                    }
                } catch (e) {
                    console.error("AI Error", e);
                    alert("Failed to connect to AI");
                } finally {
                    statusEl.style.display = 'none';
                }
            }
        </script>
</body>

</html>