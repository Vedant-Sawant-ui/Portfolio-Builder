<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Portfolio Builder</title>
    <meta name="description"
        content="Join Portfolio Builder today. Create a stunning professional portfolio in minutes with AI-powered features.">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.6)), url('/images/light_portfolio_builder_bg.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
        }

        .auth-container {
            background: transparent !important;
        }
    </style>
</head>

<body>

    <%- include('partials/header') %>

        <div class="auth-container">
            <div class="card auth-card">
                <div class="card-header" style="text-align: center;">
                    <h2 class="card-title">Create Account</h2>
                    <p class="card-subtitle">Enter your details to receive a verification OTP</p>
                </div>

                <% if (typeof errors !=='undefined' ) { %>
                    <% errors.forEach(error=> { %>
                        <div class="alert alert-error">
                            <i class="fas fa-exclamation-circle"></i>
                            <%= error.msg %>
                        </div>
                        <% }); %>
                            <% } %>

                                <form action="/register" method="POST">
                                    <div class="form-group">
                                        <label class="form-label">Username</label>
                                        <input type="text" name="username" class="form-input"
                                            placeholder="Choose a username"
                                            value="<%= typeof username != 'undefined' ? username : '' %>" required>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Email Address</label>
                                        <input type="email" name="email" class="form-input"
                                            placeholder="you@example.com"
                                            value="<%= typeof email != 'undefined' ? email : '' %>" required>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-full">Verify Email &
                                        Continue</button>
                                </form>

                                <p
                                    style="margin-top: 24px; text-align: center; font-size: 0.9rem; color: var(--slate-600);">
                                    Already have an account? <a href="/login">Login</a>
                                </p>
            </div>
        </div>
        const input = document.getElementById(targetId);
        const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
        input.setAttribute('type', type);
        this.querySelector('i').classList.toggle('fa-eye');
        this.querySelector('i').classList.toggle('fa-eye-slash');
        });
        });

        // Password Match Validation
        const form = document.querySelector('form');
        const password = document.getElementById('reg-password');
        const confirm = document.getElementById('reg-confirm-password');
        const errorMsg = document.getElementById('password-match-error');

        form.addEventListener('submit', function (e) {
        if (password.value !== confirm.value) {
        e.preventDefault();
        errorMsg.style.display = 'block';
        confirm.style.borderColor = '#dc2626';
        }
        });

        confirm.addEventListener('input', function () {
        if (password.value === confirm.value) {
        errorMsg.style.display = 'none';
        confirm.style.borderColor = 'var(--slate-200)';
        }
        });
        </script>
</body>

</html>