<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Qualification - Portfolio Builder</title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .ai-btn {
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            color: white;
            border: none;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            cursor: pointer;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: opacity 0.2s;
        }

        .ai-btn:hover {
            opacity: 0.9;
        }

        .ai-status {
            font-size: 0.8rem;
            color: var(--primary);
            margin-left: 10px;
            display: none;
            align-items: center;
            gap: 5px;
        }
    </style>
</head>

<body>

    <%- include('partials/header') %>

        <div class="container" style="max-width: 700px;">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">📜 Add Qualification</h2>
                    <p class="card-subtitle">Add certifications, internships, or education.</p>
                </div>

                <form action="/dashboard/add-qualification" method="POST" enctype="multipart/form-data">

                    <div class="form-group">
                        <label class="form-label">Type</label>
                        <select name="type" class="form-select">
                            <option value="Certification">Certification</option>
                            <option value="Internship">Internship</option>
                            <option value="License">License</option>
                            <option value="Education">Education / Degree</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Title *</label>
                        <input type="text" name="title" class="form-input"
                            placeholder="e.g. AWS Certified Cloud Practitioner" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Organization / Institution</label>
                        <input type="text" name="organization" class="form-input"
                            placeholder="e.g. Amazon Web Services">
                    </div>

                    <div class="form-group">
                        <div
                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <label class="form-label" style="margin-bottom: 0;">Description</label>
                            <div style="display: flex; align-items: center;">
                                <span id="qual-ai-status" class="ai-status"><i class="fas fa-spinner fa-spin"></i>
                                    Improving...</span>
                                <button type="button" class="ai-btn"
                                    onclick="upgradeText('qual-desc', 'qual-ai-status')">
                                    <i class="fas fa-sparkles"></i> Upgrade with AI
                                </button>
                            </div>
                        </div>
                        <textarea id="qual-desc" name="description" class="form-textarea" rows="3"
                            placeholder="Brief details..."></textarea>
                    </div>

                    <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div>
                            <label class="form-label">Start Date</label>
                            <input type="date" name="start_date" class="form-input">
                        </div>
                        <div>
                            <label class="form-label">End Date <span
                                    style="font-weight: normal; color: var(--slate-600);">(Optional)</span></label>
                            <input type="date" name="end_date" class="form-input">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Credential Link (URL)</label>
                        <input type="url" name="link_url" class="form-input" placeholder="https://...">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Upload Certificate/Document</label>
                        <input type="file" name="qual_file" accept=".pdf,image/*" class="form-input"
                            style="padding: 6px;">
                    </div>

                    <div style="margin-top: 30px; display: flex; gap: 10px;">
                        <button type="submit" class="btn btn-primary">Save Qualification</button>
                        <a href="/dashboard" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <script>
            // AI Upgrade Logic
            async function upgradeText(inputId, statusId) {
                const inputEl = document.getElementById(inputId);
                const statusEl = document.getElementById(statusId);
                const originalText = inputEl.value;

                if (!originalText || originalText.length < 5) {
                    alert("Please enter some text first.");
                    return;
                }

                statusEl.style.display = 'inline-flex';

                try {
                    const response = await fetch('/dashboard/api/upgrade-text', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ text: originalText })
                    });
                    const data = await response.json();

                    if (data.upgradedText) {
                        const improvedText = data.upgradedText;
                        let parent = inputEl.parentElement;
                        let existingControl = parent.querySelector('.ai-controls');
                        if (existingControl) existingControl.remove();

                        inputEl.value = improvedText;
                        inputEl.style.background = "#eff6ff";

                        const controls = document.createElement('div');
                        controls.className = 'ai-controls';
                        controls.style.marginTop = '10px';
                        controls.style.display = 'flex';
                        controls.style.gap = '10px';
                        controls.innerHTML = `
                            <button type="button" class="btn btn-primary btn-sm" id="btn-accept" style="background: var(--success); border:none; padding:4px 12px; font-size:0.8rem;">Accept</button>
                            <button type="button" class="btn btn-secondary btn-sm" id="btn-decline" style="padding:4px 12px; font-size:0.8rem;">Decline</button>
                        `;

                        inputEl.insertAdjacentElement('afterend', controls);

                        controls.querySelector('#btn-accept').addEventListener('click', () => {
                            inputEl.style.background = "white";
                            controls.remove();
                        });

                        controls.querySelector('#btn-decline').addEventListener('click', () => {
                            inputEl.value = originalText;
                            inputEl.style.background = "white";
                            controls.remove();
                        });
                    } else if (data.error) {
                        alert("AI Error: " + data.error);
                    }
                } catch (e) {
                    console.error("AI Error", e);
                    alert("Failed to connect to AI Service.");
                } finally {
                    statusEl.style.display = 'none';
                }
            }
        </script>
</body>

</html>