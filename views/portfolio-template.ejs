<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= user.full_name %> - Portfolio
    </title>
    <meta name="description"
        content="Check out the professional portfolio of <%= user.full_name %>. Explore projects, skills, and experience. Built with Portfolio Builder.">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= user.full_name %> - Professional Portfolio">
    <meta property="og:description" content="Explore my professional journey, projects, and skills.">
    <% if (user.profile_pic_url) { %>
        <meta property="og:image" content="<%= user.profile_pic_url %>">
        <% } %>

            <link rel="stylesheet" href="/css/styles.css">

            <link rel="stylesheet" href="/css/master-themes.css">
            <link rel="stylesheet" type='text/css'
                href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="theme-<%= theme %>">

    <% if (theme==='dynamic_codeverse' ) { %>
        <div class="bg-layer codeverse-bg"></div>
        <div class="codeverse-symbol">&lt;/&gt;</div>
        <canvas id="stardust-canvas"></canvas>

        <% } else if (theme==='dynamic_neural' ) { %>
            <div id="particles-js" class="bg-layer"></div>

            <% } else if (theme==='dynamic_liquid' ) { %>
                <div class="liquid-blobs">
                    <div class="blob blob-1"></div>
                    <div class="blob blob-2"></div>
                    <div class="blob blob-3"></div>
                </div>

                <% } else if (theme==='dynamic_cybergrid' ) { %>
                    <div class="cyber-grid-floor"></div>
                    <div class="cyber-sun"></div>

                    <% } else if (theme==='dynamic_terminal' ) { %>
                        <div class="matrix-rain-overlay"></div>
                        <% } %>

                            <div class="content-wrapper">
                                <!-- REORDERED SECTIONS START -->

                                <!-- 1. HEADER -->
                                <header class="profile-header">
                                    <% if (user.profile_pic_url) { %>
                                        <img src="<%= user.profile_pic_url %>" alt="Profile" class="profile-pic">
                                        <% } else { %>
                                            <div class="profile-pic-placeholder"><i class="fas fa-user"></i></div>
                                            <% } %>
                                                <h1 class="name">
                                                    <%= user.full_name %>
                                                </h1>
                                                <p class="bio">
                                                    <%= user.bio %>
                                                </p>
                                                <% if (user.resume_url) { %>
                                                    <a href="<%= user.resume_url %>" class="btn btn-primary"
                                                        target="_blank">Download Resume</a>
                                                    <% } %>
                                </header>

                                <% const getSkillSlug=(name)=> {
                                    let lower = name.toLowerCase().trim();
                                    const slugMap = { 'c++': 'cpp', 'cpp': 'cpp', 'c#': 'cs', 'csharp': 'cs', 'html':
                                    'html', 'html5': 'html', 'css': 'css', 'css3': 'css', 'javascript': 'js', 'js':
                                    'js', 'python': 'py', 'py': 'py', 'java': 'java', 'react': 'react', 'react.js':
                                    'react', 'reactjs': 'react', 'node': 'nodejs', 'node.js': 'nodejs', 'nodejs':
                                    'nodejs', 'vue': 'vue', 'vue.js': 'vue', 'vuejs': 'vue', 'angular': 'angular',
                                    'angular.js': 'angular', 'express': 'express', 'express.js': 'express', 'next':
                                    'nextjs', 'next.js': 'nextjs', 'mongo': 'mongodb', 'mongodb': 'mongodb', 'sql':
                                    'mysql', 'mysql': 'mysql', 'postgres': 'postgres', 'postgresql': 'postgres', 'aws':
                                    'aws', 'gcp': 'gcp', 'azure': 'azure', 'docker': 'docker', 'kubernetes':
                                    'kubernetes', 'k8s': 'kubernetes', 'git': 'git', 'linux': 'linux', 'tailwind':
                                    'tailwindcss', 'tailwind css': 'tailwindcss', 'bootstrap': 'bootstrap', 'sass':
                                    'sass', 'figma': 'figma' };
                                    return slugMap[lower] || lower.replace(/\s+/g, '').replace(/\./g, '');
                                    };
                                    %>

                                    <!-- 2. SKILLS -->
                                    <section class="skills-section">
                                        <h2>Technical Skills</h2>
                                        <div class="skills-grid">
                                            <% if (typeof skills !=='undefined' && skills.length> 0) { %>
                                                <% skills.forEach(skill=> { %>
                                                    <div class="skill-pill">
                                                        <img src="https://skillicons.dev/icons?i=<%= getSkillSlug(skill.skill_name) %>"
                                                            alt="<%= skill.skill_name %>" class="skill-icon-img"
                                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='block'">
                                                        <span class="skill-fallback" style="display:none;">Code</span>
                                                        <span class="skill-name">
                                                            <%= skill.skill_name %>
                                                        </span>
                                                    </div>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <p>No skills listed yet.</p>
                                                            <% } %>
                                        </div>
                                    </section>

                                    <!-- 3. PROJECTS (Moved Up) -->
                                    <section class="projects-section">
                                        <h2>Projects</h2>
                                        <div class="projects-grid">
                                            <% projects.forEach(project=> { %>
                                                <div class="card project-card">
                                                    <% if (project.thumbnail_url) { %>
                                                        <img src="<%= project.thumbnail_url %>" alt="Project Thumb"
                                                            class="card-img">
                                                        <% } %>
                                                            <div class="card-content">
                                                                <h3>
                                                                    <%= project.title %>
                                                                </h3>
                                                                <p>
                                                                    <%= project.description %>
                                                                </p>
                                                                <% if(project.project_link) { %>
                                                                    <a href="<%= project.project_link %>"
                                                                        target="_blank" class="btn btn-secondary">View
                                                                        Code</a>
                                                                    <% } %>
                                                            </div>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </section>

                                    <!-- 4. QUALIFICATIONS (Moved Down) -->
                                    <% if (typeof qualifications !=='undefined' && qualifications.length> 0) { %>
                                        <section class="qualifications-section"
                                            style="margin-top: 40px; margin-bottom: 40px;">
                                            <h2>Experience & Qualifications</h2>
                                            <div class="qual-grid">
                                                <% qualifications.forEach(qual=> { %>
                                                    <div class="qual-card">
                                                        <div class="qual-header">
                                                            <span class="qual-type">
                                                                <%= qual.type %>
                                                            </span>
                                                            <% if (qual.start_date) { %>
                                                                <span class="qual-date">
                                                                    <%= new Date(qual.start_date).getFullYear() %>
                                                                        <% if (qual.end_date) { %> - <%= new
                                                                                Date(qual.end_date).getFullYear() %>
                                                                                <% } %>
                                                                </span>
                                                                <% } %>
                                                        </div>
                                                        <h3>
                                                            <%= qual.title %>
                                                        </h3>
                                                        <p class="qual-org"><i class="fas fa-building"
                                                                style="margin-right: 5px;"></i>
                                                            <%= qual.organization %>
                                                        </p>
                                                        <% if (qual.description) { %>
                                                            <p class="qual-desc">
                                                                <%= qual.description %>
                                                            </p>
                                                            <% } %>
                                                                <div class="qual-links">
                                                                    <% if (qual.link_url) { %>
                                                                        <a href="<%= qual.link_url %>" target="_blank"
                                                                            class="qual-btn"><i class="fas fa-link"></i>
                                                                            Verify</a>
                                                                        <% } %>
                                                                            <% if (qual.file_url) { %>
                                                                                <a href="<%= qual.file_url %>"
                                                                                    target="_blank"
                                                                                    class="qual-btn outline"><i
                                                                                        class="fas fa-file-pdf"></i>
                                                                                    View Doc</a>
                                                                                <% } %>
                                                                </div>
                                                    </div>
                                                    <% }) %>
                                            </div>
                                        </section>
                                        <style>
                                            /* Qualifications CSS (Inlined for simplicity in template) */
                                            .qual-grid {
                                                display: grid;
                                                grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
                                                gap: 20px;
                                            }

                                            .qual-card {
                                                background: rgba(255, 255, 255, 0.05);
                                                border: 1px solid rgba(0, 0, 0, 0.1);
                                                padding: 20px;
                                                border-radius: 10px;
                                                transition: transform 0.2s;
                                                position: relative;
                                                overflow: hidden;
                                            }

                                            .theme-dynamic_codeverse .qual-card,
                                            .theme-dynamic_neural .qual-card {
                                                background: rgba(255, 255, 255, 0.1);
                                                border: 1px solid rgba(255, 255, 255, 0.2);
                                                color: white;
                                            }

                                            .qual-card:hover {
                                                transform: translateY(-5px);
                                            }

                                            .qual-header {
                                                display: flex;
                                                justify-content: space-between;
                                                font-size: 0.85em;
                                                margin-bottom: 10px;
                                                opacity: 0.7;
                                                text-transform: uppercase;
                                                letter-spacing: 0.5px;
                                            }

                                            .qual-type {
                                                background: rgba(0, 123, 255, 0.1);
                                                color: #007bff;
                                                padding: 2px 8px;
                                                border-radius: 4px;
                                                font-weight: bold;
                                            }

                                            [class*="theme-dynamic"] .qual-type {
                                                background: rgba(64, 224, 208, 0.2);
                                                color: #40e0d0;
                                            }

                                            .qual-card h3 {
                                                margin: 0 0 5px 0;
                                                font-size: 1.2rem;
                                            }

                                            .qual-org {
                                                font-weight: 500;
                                                margin-bottom: 10px;
                                                opacity: 0.8;
                                            }

                                            .qual-desc {
                                                font-size: 0.95em;
                                                line-height: 1.5;
                                                margin-bottom: 15px;
                                                opacity: 0.8;
                                            }

                                            .qual-links {
                                                display: flex;
                                                gap: 10px;
                                                margin-top: auto;
                                            }

                                            .qual-btn {
                                                text-decoration: none;
                                                font-size: 0.9em;
                                                padding: 6px 12px;
                                                border-radius: 4px;
                                                background: #007bff;
                                                color: white;
                                                transition: background 0.2s;
                                            }

                                            .qual-btn:hover {
                                                background: #0056b3;
                                            }

                                            .qual-btn.outline {
                                                background: transparent;
                                                border: 1px solid #007bff;
                                                color: #007bff;
                                            }

                                            .qual-btn.outline:hover {
                                                background: rgba(0, 123, 255, 0.1);
                                            }

                                            [class*="theme-dynamic"] .qual-btn.outline {
                                                border-color: #fff;
                                                color: #fff;
                                            }

                                            .skill-pill {
                                                display: flex;
                                                flex-direction: column;
                                                align-items: center;
                                                gap: 10px;
                                                background: rgba(255, 255, 255, 0.05);
                                                padding: 15px;
                                                border-radius: 12px;
                                                transition: transform 0.3s ease;
                                                min-width: 100px;
                                            }

                                            .skill-pill:hover {
                                                transform: translateY(-5px);
                                                background: rgba(255, 255, 255, 0.1);
                                                padding: 15px;
                                            }

                                            .skill-icon-img {
                                                width: 48px;
                                                height: 48px;
                                                object-fit: contain;
                                                border-radius: 5px;
                                            }

                                            .theme-dynamic_codeverse .skill-pill,
                                            .theme-dynamic_neural .skill-pill {
                                                border: 1px solid rgba(255, 255, 255, 0.1);
                                            }
                                        </style>
                                        <% } %>

                                            <!-- 5. GITHUB & LEETCODE -->
                                            <% if (user.leetcode_username) { %>
                                                <section class="leetcode-section">
                                                    <% const isDark=theme.includes('dark') || theme.includes('dynamic')
                                                        || theme.includes('corporate'); %>
                                                        <img src="https://leetcard.jacoblin.cool/<%= user.leetcode_username %>?theme=<%= isDark ? 'dark' : 'light' %>&font=Segoe%20UI&ext=heatmap"
                                                            alt="LeetCode Stats"
                                                            style="width: 100%; max-width: 400px; border-radius: 8px;">
                                                </section>
                                                <% } %>

                                                    <% if (user.github_username) { %>
                                                        <section class="github-section" style="margin-top: 20px;">
                                                            <% const isDarkGit=theme.includes('dark') ||
                                                                theme.includes('dynamic') ||
                                                                theme.includes('corporate'); const gitTheme=isDarkGit
                                                                ? 'radical' : 'default' ; %>
                                                                <h2 style="margin-bottom: 15px;">GitHub Activity</h2>
                                                                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                                                                    <img src="https://github-readme-stats.vercel.app/api/top-langs/?username=<%= user.github_username %>&layout=compact&theme=<%= gitTheme %>&hide_border=true"
                                                                        alt="Top Languages" style="height: 165px;"
                                                                        onerror="this.style.display='none'; document.getElementById('gh-fallback').style.display='block'">
                                                                    <img src="https://github-readme-stats.vercel.app/api?username=<%= user.github_username %>&show_icons=true&theme=<%= gitTheme %>&hide_border=true"
                                                                        alt="GitHub Stats" style="height: 165px;"
                                                                        onerror="this.style.display='none'; document.getElementById('gh-fallback').style.display='block'">
                                                                    <img src="https://github-readme-streak-stats.herokuapp.com/?user=<%= user.github_username %>&theme=<%= gitTheme %>&hide_border=true"
                                                                        alt="GitHub Streak" style="height: 165px;"
                                                                        onerror="this.style.display='none'; document.getElementById('gh-fallback').style.display='block'">
                                                                    <div id="gh-fallback"
                                                                        style="display:none; width: 100%; text-align: center; margin-top: 10px;">
                                                                        <a href="https://github.com/<%= user.github_username %>"
                                                                            target="_blank" class="btn btn-secondary"><i
                                                                                class="fab fa-github"></i> View My
                                                                            GitHub Profile</a>
                                                                    </div>
                                                                </div>
                                                        </section>
                                                        <% } %>

                                                            <!-- 6. ACHIEVEMENTS -->
                                                            <% if (typeof achievements !=='undefined' &&
                                                                achievements.length> 0) { %>
                                                                <section class="achievements-section">
                                                                    <h2>Achievements & Awards</h2>
                                                                    <div class="achievements-list">
                                                                        <% achievements.forEach(ach=> { %>
                                                                            <div class="achievement-item">
                                                                                <% if (ach.image_url) { %>
                                                                                    <img src="<%= ach.image_url %>"
                                                                                        alt="Achievement"
                                                                                        class="achievement-img">
                                                                                    <% } else { %>
                                                                                        <div class="achievement-icon">🏆
                                                                                        </div>
                                                                                        <% } %>
                                                                                            <div
                                                                                                class="achievement-content">
                                                                                                <h3>
                                                                                                    <%= ach.title %>
                                                                                                </h3>
                                                                                                <% if (ach.description)
                                                                                                    { %>
                                                                                                    <p>
                                                                                                        <%= ach.description
                                                                                                            %>
                                                                                                    </p>
                                                                                                    <% } %>
                                                                                                        <% if
                                                                                                            (ach.achievement_date)
                                                                                                            { %>
                                                                                                            <span
                                                                                                                class="achievement-date">
                                                                                                                <%= new
                                                                                                                    Date(ach.achievement_date).toLocaleDateString('en-US',
                                                                                                                    {
                                                                                                                    month: 'short'
                                                                                                                    ,
                                                                                                                    year: 'numeric'
                                                                                                                    })
                                                                                                                    %>
                                                                                                            </span>
                                                                                                            <% } %>
                                                                                            </div>
                                                                            </div>
                                                                            <% }) %>
                                                                    </div>
                                                                    <style>
                                                                        .project-card .card-img {
                                                                            width: 100%;
                                                                            height: 200px;
                                                                            object-fit: cover;
                                                                            border-top-left-radius: 8px;
                                                                            border-top-right-radius: 8px;
                                                                        }

                                                                        .achievement-img {
                                                                            width: 120px;
                                                                            height: 120px;
                                                                            object-fit: cover;
                                                                            border-radius: 8px;
                                                                            flex-shrink: 0;
                                                                            border: 1px solid rgba(255, 255, 255, 0.1);
                                                                        }

                                                                        .achievements-list {
                                                                            display: flex;
                                                                            flex-direction: column;
                                                                            gap: 15px;
                                                                            margin-top: 20px;
                                                                        }

                                                                        .achievement-item {
                                                                            display: flex;
                                                                            align-items: flex-start;
                                                                            gap: 15px;
                                                                            background: rgba(255, 255, 255, 0.05);
                                                                            padding: 15px;
                                                                            border-radius: 8px;
                                                                            border: 1px solid rgba(0, 0, 0, 0.1);
                                                                        }

                                                                        .achievement-icon {
                                                                            font-size: 1.5rem;
                                                                        }

                                                                        .achievement-content h3 {
                                                                            margin: 0 0 5px 0;
                                                                            font-size: 1.1rem;
                                                                        }

                                                                        .achievement-content p {
                                                                            margin: 0 0 5px 0;
                                                                            font-size: 0.95rem;
                                                                            opacity: 0.8;
                                                                        }

                                                                        .achievement-date {
                                                                            font-size: 0.85rem;
                                                                            opacity: 0.6;
                                                                        }

                                                                        .theme-dynamic_codeverse .achievement-item,
                                                                        .theme-dynamic_neural .achievement-item {
                                                                            background: rgba(255, 255, 255, 0.1);
                                                                            border: 1px solid rgba(255, 255, 255, 0.2);
                                                                        }
                                                                    </style>
                                                                </section>
                                                                <% } %>

                            </div> <!-- CLOSING CONTENT WRAPPER HERE TO FIX FOOTER WIDTH -->

                            <!-- 7. FOOTER (Moved Outside) -->
                            <footer class="glass-footer">
                                <div class="footer-content">
                                    <div class="footer-left">
                                        <% if (user.public_email) { %>
                                            <div class="footer-contact-item">
                                                <i class="fas fa-envelope"></i>
                                                <a href="mailto:<%= user.public_email %>"
                                                    style="color: inherit; text-decoration: none;">
                                                    <%= user.public_email %>
                                                </a>
                                            </div>
                                            <% } %>
                                                <% if (user.phone) { %>
                                                    <div class="footer-contact-item">
                                                        <i class="fas fa-phone"></i>
                                                        <span>
                                                            <%= user.phone %>
                                                        </span>
                                                    </div>
                                                    <% } %>
                                                        <% if (!user.public_email && !user.phone) { %>
                                                            <span style="opacity: 0.5;">Contact info not shared</span>
                                                            <% } %>
                                    </div>

                                    <div class="footer-center">
                                        <p style="margin: 0; font-weight: bold;">&copy; <%= new Date().getFullYear() %>
                                                <%= user.full_name %>
                                        </p>
                                        <small style="opacity: 0.6;">All Rights Reserved</small>
                                    </div>

                                    <div class="footer-right">
                                        <% if (socials && socials.length> 0) { %>
                                            <% socials.forEach(social=> { %>
                                                <a href="<%= social.platform_url %>" target="_blank"
                                                    class="social-icon-btn" title="<%= social.platform_name %>">
                                                    <% let iconClass='fas fa-link' ; const
                                                        p=social.platform_name.toLowerCase(); if(p.includes('linked'))
                                                        iconClass='fab fa-linkedin-in' ; else if(p.includes('github'))
                                                        iconClass='fab fa-github' ; else if(p.includes('insta'))
                                                        iconClass='fab fa-instagram' ; else if(p.includes('facebook'))
                                                        iconClass='fab fa-facebook-f' ; else if(p.includes('youtube'))
                                                        iconClass='fab fa-youtube' ; else if(p.includes('twitter') ||
                                                        p.includes('x')) iconClass='fab fa-twitter' ; else
                                                        if(p.includes('naukri')) iconClass='fas fa-briefcase' ; %>
                                                        <i class="<%= iconClass %>"></i>
                                                </a>
                                                <% }) %>
                                                    <% } else { %>
                                                        <span style="opacity: 0.5;">No socials</span>
                                                        <% } %>
                                    </div>
                                </div>
                                <style>
                                    /* Footer Styling update */
                                    .glass-footer {
                                        margin-top: 60px;
                                        padding: 30px 40px;
                                        background: rgba(15, 15, 15, 0.95);
                                        backdrop-filter: blur(10px);
                                        border-top: 1px solid rgba(255, 255, 255, 0.1);
                                        color: #e0e0e0;
                                        width: 100%;
                                        box-sizing: border-box;
                                    }

                                    .footer-content {
                                        max-width: 1200px;
                                        margin: 0 auto;
                                        display: flex;
                                        justify-content: space-between;
                                        align-items: center;
                                        flex-wrap: wrap;
                                        gap: 20px;
                                    }

                                    .footer-left,
                                    .footer-center,
                                    .footer-right {
                                        flex: 1;
                                        min-width: 200px;
                                    }

                                    .footer-center {
                                        text-align: center;
                                    }

                                    .footer-right {
                                        text-align: right;
                                    }

                                    .footer-contact-item {
                                        display: flex;
                                        align-items: center;
                                        gap: 10px;
                                        margin-bottom: 8px;
                                        font-size: 0.9em;
                                        color: #bbb;
                                    }

                                    .social-icon-btn {
                                        display: inline-flex;
                                        align-items: center;
                                        justify-content: center;
                                        width: 35px;
                                        height: 35px;
                                        background: rgba(255, 255, 255, 0.1);
                                        border-radius: 50%;
                                        color: white;
                                        text-decoration: none;
                                        margin-left: 10px;
                                        transition: all 0.3s ease;
                                    }

                                    .social-icon-btn:hover {
                                        background: #007bff;
                                        transform: translateY(-3px);
                                    }

                                    @media (max-width: 768px) {
                                        .footer-content {
                                            flex-direction: column;
                                            text-align: center;
                                        }

                                        .footer-right {
                                            text-align: center;
                                        }

                                        .footer-contact-item {
                                            justify-content: center;
                                        }

                                        .social-icon-btn {
                                            margin: 0 5px;
                                        }
                                    }
                                </style>
                            </footer>
                            <% if (theme && theme.startsWith('dynamic_')) { %>
                                <script>
                                    // --- 1. DEFINE THE EFFECTS FUNCTIONS DIRECTLY HERE ---

                                    function initThemeEffect(themeName) {
                                        console.log("Initializing effect for:", themeName);

                                        // Cleanup existing canvases
                                        const existingCanvas = document.getElementById('effect-canvas');
                                        if (existingCanvas) existingCanvas.remove();

                                        // Route to the correct effect
                                        if (themeName === 'dynamic_codeverse') {
                                            createStarfield();
                                        } else if (themeName === 'dynamic_neural') {
                                            createNeuralNetwork();
                                        } else if (themeName === 'dynamic_terminal') {
                                            createMatrixRain();
                                        }
                                    }

                                    function createStarfield() {
                                        const canvas = createCanvas();
                                        const ctx = canvas.getContext('2d');
                                        let width = canvas.width = window.innerWidth;
                                        let height = canvas.height = window.innerHeight;

                                        const stars = Array(200).fill().map(() => ({
                                            x: Math.random() * width,
                                            y: Math.random() * height,
                                            size: Math.random() * 2,
                                            speed: Math.random() * 0.5
                                        }));

                                        function animate() {
                                            ctx.clearRect(0, 0, width, height);
                                            ctx.fillStyle = 'white';
                                            stars.forEach(star => {
                                                star.y += star.speed;
                                                if (star.y > height) star.y = 0;
                                                ctx.beginPath();
                                                ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
                                                ctx.fill();
                                            });
                                            requestAnimationFrame(animate);
                                        }
                                        animate();
                                    }

                                    function createMatrixRain() {
                                        const canvas = createCanvas();
                                        canvas.style.opacity = '0.15';
                                        const ctx = canvas.getContext('2d');
                                        let width = canvas.width = window.innerWidth;
                                        let height = canvas.height = window.innerHeight;
                                        const cols = Math.floor(width / 20);
                                        const ypos = Array(cols).fill(0);

                                        ctx.fillStyle = '#000';
                                        ctx.fillRect(0, 0, width, height);

                                        function matrix() {
                                            ctx.fillStyle = '#0001';
                                            ctx.fillRect(0, 0, width, height);
                                            ctx.fillStyle = '#0f0';
                                            ctx.font = '15pt monospace';
                                            ypos.forEach((y, ind) => {
                                                const text = String.fromCharCode(Math.random() * 128);
                                                const x = ind * 20;
                                                ctx.fillText(text, x, y);
                                                if (y > 100 + Math.random() * 10000) ypos[ind] = 0;
                                                else ypos[ind] = y + 20;
                                            });
                                            requestAnimationFrame(matrix);
                                        }
                                        matrix();
                                    }

                                    function createNeuralNetwork() {
                                        const canvas = createCanvas();
                                        canvas.style.opacity = '0.3';
                                        const ctx = canvas.getContext('2d');
                                        let width = canvas.width = window.innerWidth;
                                        let height = canvas.height = window.innerHeight;
                                        const particles = Array(80).fill().map(() => ({
                                            x: Math.random() * width,
                                            y: Math.random() * height,
                                            vx: (Math.random() - 0.5) * 2,
                                            vy: (Math.random() - 0.5) * 2
                                        }));

                                        function animate() {
                                            ctx.clearRect(0, 0, width, height);
                                            ctx.fillStyle = '#00e5ff';
                                            ctx.strokeStyle = '#00e5ff';
                                            particles.forEach((p, i) => {
                                                p.x += p.vx;
                                                p.y += p.vy;
                                                if (p.x < 0 || p.x > width) p.vx *= -1;
                                                if (p.y < 0 || p.y > height) p.vy *= -1;
                                                ctx.beginPath();
                                                ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
                                                ctx.fill();
                                                particles.slice(i + 1).forEach(p2 => {
                                                    const dx = p.x - p2.x;
                                                    const dy = p.y - p2.y;
                                                    const dist = Math.sqrt(dx * dx + dy * dy);
                                                    if (dist < 150) {
                                                        ctx.beginPath();
                                                        ctx.moveTo(p.x, p.y);
                                                        ctx.lineTo(p2.x, p2.y);
                                                        ctx.globalAlpha = 1 - (dist / 150);
                                                        ctx.stroke();
                                                        ctx.globalAlpha = 1;
                                                    }
                                                });
                                            });
                                            requestAnimationFrame(animate);
                                        }
                                        animate();
                                    }

                                    function createCanvas() {
                                        const canvas = document.createElement('canvas');
                                        canvas.id = 'effect-canvas';
                                        canvas.style.position = 'fixed';
                                        canvas.style.top = '0';
                                        canvas.style.left = '0';
                                        canvas.style.width = '100%';
                                        canvas.style.height = '100%';
                                        canvas.style.zIndex = '0';
                                        canvas.style.pointerEvents = 'none';
                                        document.body.prepend(canvas);
                                        return canvas;
                                    }

                                    // --- 2. INITIALIZE ---
                                    document.addEventListener("DOMContentLoaded", function () {
                                        initThemeEffect('<%= theme %>');
                                    });
                                </script>
                                <% } %>

</body>

</html>